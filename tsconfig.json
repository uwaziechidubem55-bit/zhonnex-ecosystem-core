{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "core-applications/**/*.ts",
    "commerce-finance/**/*.ts",
    "shared-packages/**/*.ts",
    "resolve/**/*.ts"
  ]
}
