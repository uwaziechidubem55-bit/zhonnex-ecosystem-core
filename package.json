{
  "name": "zhonnex-ecosystem-core",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "core-applications/**",
    "commerce-finance/**",
    "shared-packages/**"
  ],
  "scripts": {
    "system:compile:release": "cd core-system && cargo build --release --locked",
    "mx-suite:test": "cd core-system/mx-suite && cargo test",
    "ecosystem:production:build": "turbo run build --cache-dir=.turbo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "typescript": "^5.5.4"
  }
}
